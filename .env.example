# Copy this to .env and update the values for your local environment.
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=True

# MySQL settings (used when USE_SQLITE is False)
DB_NAME=college_management
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional email config for production-style setup
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
